{
  "backbone": "nlinear",
  "channel_order": [
    "open",
    "high",
    "low",
    "close",
    "volume"
  ],
  "context_length": 64,
  "conv1d_kernel_size": 0,
  "dropout": 0.1,
  "embedding_dim": 128,
  "full_path_loss": "l1_mean",
  "horizon": 8,
  "num_blocks": 1,
  "num_heads": 8,
  "num_initial_tokens": 1,
  "num_tokens_per_variate": 1,
  "num_variates": 5,
  "packing": 1,
  "reverse_view": "latent_feature_axis",
  "revin_affine": false,
  "revin_epsilon": 1e-05
}
