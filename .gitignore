# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment
.env
.venv/
myenv/
env/
*.env

# Python cache
*.pyc
*.pyo
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# PyTorch / TensorFlow
*.pt
*.pth
*.ckpt
*.h5

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# VS Code
.vscode/

# MacOS
.DS_Store

# Logs and debug
*.log
debug.log

# Data files (raw / large)
data/
data_new/
# Phase 5 add-on datasets are experiment artifacts despite the shared `data` name.
!experiments/phase5/downstream_addons/shared/h8/data/
!experiments/phase5/downstream_addons/shared/h8/data/**
*.feather
*.csv
*.hdf5

# Saved models
saved_models/
superpowers/
progress_summary/
baseline_summaries/

# Phase-2 horizontal encoder artifacts retained locally (large/recoverable)
experiments/framework/phase2/encoder_refinement_horizontal/features/**/*.npz
experiments_old/framework/phase2/encoder_refinement_horizontal/features/**/*.npz

# Phase 5 restart-only feature-extraction chunks (canonical stores are retained)
experiments/phase5/features/**/.five_branch_epoch50.work/
# Canonical stores exceed normal Git hosting limits; manifests/hashes are versioned.
experiments/phase5/features/**/five_branch_epoch50.npz
experiments/phase5/downstream_addons/shared/h8/features/**/.five_branch_epoch50.work/
experiments/phase5/downstream_addons/shared/h8/features/**/five_branch_epoch50.npz

# Phase 6 canonical volatility feature stores are reproducible from Phase 5
# stores and exceed normal Git hosting limits; retain their manifests/hashes.
experiments/phase6/volatility_prediction/features/**/five_branch_epoch50_h8.npz

# Phase 6 temporal-variant master feature stores are reproducible from frozen
# Phase 5 features and epoch-50 temporal checkpoints; retain their manifests.
experiments/phase6/encoder_variants/features/**/*.npz

# Phase 6.5 LSTM-capacity master feature stores are reproducible from frozen
# Phase 5 features and epoch-50 two-layer LSTM checkpoints; retain manifests.
experiments/phase6_5/lstm_capacity/features/**/*.npz

# Phase 6.5D residual-CNN price feature stores are reproducible from frozen
# Phase 5 features and epoch-50 residual-CNN checkpoints; retain manifests.
experiments/phase6_5/residual_cnn/features/**/*.npz

# Phase 6.5 TA feature/intersection stores are reproducible from the frozen
# Phase 5 walk bundles; retain their manifests and hashes.
experiments/phase6_5/ta_mlp/data_preparation/**/*.npz

# Phase 6.7 external-representation master stores are reproducible from the
# local epoch-50 checkpoints; retain their manifests and hashes.
experiments/phase6_7/features/**/*.npz
